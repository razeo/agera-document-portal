# AGERA Document Portal — Environment Configuration
# Copy this file to .env.local and fill in real values.
# DO NOT commit .env.local.

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-me-to-random-32-char-string

# ── AGERA Wiki Integration ────────────────────────────────────────────────────
# AGERA wiki directory (markdown files, e.g. ~/agera-knowledge/wiki)
WIKI_PATH=/home/razzee/agera-knowledge/wiki

# ── PDF Generation ───────────────────────────────────────────────────────────
# Temporary directory for generated PDFs (auto-cleanup after download)
GENERATED_PDFS_DIR=generated_pdfs

# ── Supabase (optional, for future user accounts / saved documents) ──────────
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Monitoring (optional) ────────────────────────────────────────────────────
# Sentry DSN for error tracking (TBD)
SENTRY_DSN=

# ── Notifications (optional) ─────────────────────────────────────────────────
# Slack webhook for deployment / error alerts
SLACK_WEBHOOK_URL=

# ── Production (when deployed) ────────────────────────────────────────────────
# Full URL where app is accessible (used for health checks, notifications)
PRODUCTION_URL=http://localhost:5000
